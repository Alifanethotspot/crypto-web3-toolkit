# API Keys
OPENAI_API_KEY=your_openai_key_here
ETHERSCAN_API_KEY=your_etherscan_key_here
POLYGONSCAN_API_KEY=your_polygonscan_key_here
BSCSCAN_API_KEY=your_bscscan_key_here
SOLSCAN_API_KEY=your_solscan_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/crypto_toolkit
REDIS_URL=redis://localhost:6379/0

# Mock Mode (set to true for testing without API keys)
MOCK_MODE=true

# Security
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
